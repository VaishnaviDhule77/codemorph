# CodeMorph configuration template.
# Copy to `.env` and adjust. NEVER commit real secrets.
# NOTE (Phase 7): CodeMorph reads the PROCESS environment. A `.env` file is
# a template only -- load it yourself (e.g. `set -a; source .env; set +a`)
# to keep the dependency count at zero.

# --- LLM integration (Phase 7) ---------------------------------------------
# Provider: none | openai (any OpenAI-compatible chat-completions API)
CODEMORPH_LLM_PROVIDER=none
# API key is read from the environment, never from source control.
# CODEMORPH_LLM_API_KEY=
# CODEMORPH_LLM_MODEL=gpt-4o-mini
# Optional: override for OpenAI-compatible endpoints (local, vLLM, ...)
# CODEMORPH_LLM_BASE_URL=https://api.openai.com/v1
# CODEMORPH_LLM_TIMEOUT=60

# --- Sandboxed execution ------------------------------------------------------
# Timeout in seconds for executing analyzed/generated code in tests.
CODEMORPH_EXEC_TIMEOUT=5
